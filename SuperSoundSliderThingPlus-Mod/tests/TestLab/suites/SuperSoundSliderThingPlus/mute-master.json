{
  "name": "mute-master",
  "description": "The master slider IS the game's master volume: slider -> game, game -> slider, and it silences the mixer",
  "timeout": 60,
  "steps": [
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.volume.save"
    },
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.mute.set",
      "args": {
        "slider": "Master",
        "value": 100
      },
      "contains": "Success"
    },
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.volume.game",
      "expect": 0,
      "label": "slider 100 -> game volume 0"
    },
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.volume.sfxSilent",
      "expect": true,
      "label": "mixer silent"
    },
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.mute.set",
      "args": {
        "slider": "Master",
        "value": 0
      },
      "contains": "Success"
    },
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.volume.game",
      "expect": 1,
      "label": "slider 0 -> game volume 1"
    },
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.volume.sfxAudible",
      "expect": true,
      "label": "mixer audible"
    },
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.mute.set",
      "args": {
        "slider": "Master",
        "value": 25
      },
      "contains": "Success"
    },
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.volume.game",
      "expect": 0.75,
      "label": "slider 25 -> game volume 0.75"
    },
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.volume.setGame",
      "args": {
        "value": 0.4
      },
      "contains": "stored",
      "label": "player confirms 40% in the settings"
    },
    {
      "do": "wait",
      "until": {
        "check": "hook",
        "name": "SuperSoundSliderThingPlus.mute.value",
        "expect": 60,
        "args": {
          "slider": "Master"
        }
      },
      "timeout": 5
    },
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.volume.restore",
      "contains": "restored"
    },
    {
      "do": "wait",
      "seconds": 1
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "SuperSoundSliderThingPlus"
    }
  ]
}