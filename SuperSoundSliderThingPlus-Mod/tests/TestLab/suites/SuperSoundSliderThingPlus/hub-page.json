{
  "name": "hub-page",
  "description": "KydlCore acceptance (spec 4): the mod is in the F6 hub with its tabs, the page renders through the shared UI, the hub opens and closes cleanly",
  "timeout": 60,
  "steps": [
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    {
      "do": "hook",
      "name": "kc.hubOpen",
      "args": {
        "mod": "com.kydldev.SuperSoundSliderThingPlus"
      },
      "expect": true
    },
    {
      "do": "wait",
      "until": {
        "check": "hook",
        "name": "kc.hubIsOpen",
        "expect": true
      },
      "timeout": 5
    },
    {
      "do": "hook",
      "name": "kc.hubMods",
      "contains": "com.kydldev.SuperSoundSliderThingPlus"
    },
    {
      "do": "hook",
      "name": "kc.hubTabs",
      "args": {
        "mod": "com.kydldev.SuperSoundSliderThingPlus"
      },
      "contains": "sound",
      "label": "sound tab"
    },
    {
      "do": "hook",
      "name": "kc.hubTabs",
      "args": {
        "mod": "com.kydldev.SuperSoundSliderThingPlus"
      },
      "contains": "settings",
      "label": "settings tab"
    },
    {
      "do": "check",
      "check": "uiVisible",
      "text": "Mute levels",
      "label": "the sound page is drawn"
    },
    {
      "do": "hook",
      "name": "kc.hubClose"
    },
    {
      "do": "wait",
      "until": {
        "check": "hook",
        "name": "kc.hubIsOpen",
        "expect": false
      },
      "timeout": 5
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "SuperSoundSliderThingPlus"
    }
  ]
}
