{
  "name": "mute-factors",
  "description": "The live factor of a category is 1 - its own mute (the master is the game's volume, not part of it)",
  "timeout": 60,
  "steps": [
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.mute.set",
      "args": {
        "slider": "WolfPup",
        "value": 50
      },
      "contains": "Success"
    },
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.sound.factor",
      "args": {
        "category": "WolfPup"
      },
      "expect": 0.5,
      "label": "category 50 -> 0.5"
    },
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.sound.factor",
      "args": {
        "category": "Weather"
      },
      "expect": 1,
      "label": "others untouched"
    },
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.mute.set",
      "args": {
        "slider": "WolfPup",
        "value": 100
      },
      "contains": "Success"
    },
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.sound.factor",
      "args": {
        "category": "WolfPup"
      },
      "expect": 0,
      "label": "category 100 mutes it"
    },
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.mute.set",
      "args": {
        "slider": "WolfPup",
        "value": 0
      },
      "contains": "Success"
    },
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.sound.factor",
      "args": {
        "category": "WolfPup"
      },
      "expect": 1,
      "label": "back to full loudness"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "SuperSoundSliderThingPlus"
    }
  ]
}