{
  "name": "example-command",
  "description": "EXAMPLE (template): the hub slider's path (dispatcher -> handler -> rules -> executor) clamps and applies; replace with the mod's real behaviour tests",
  "timeout": 60,
  "steps": [
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.example.set",
      "args": {
        "value": 3
      },
      "contains": "Success",
      "label": "in range"
    },
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.example.value",
      "expect": 3
    },
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.example.set",
      "args": {
        "value": 42
      },
      "contains": "Success",
      "label": "out of range is accepted (clamped)"
    },
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.example.value",
      "expect": 10
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "SuperSoundSliderThingPlus"
    }
  ]
}
