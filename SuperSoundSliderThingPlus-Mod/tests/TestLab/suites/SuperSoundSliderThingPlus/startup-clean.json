{
  "name": "startup-clean",
  "description": "The mod's own InGameTests pass in a TestLab world and nothing logged an error",
  "timeout": 60,
  "steps": [
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    {
      "do": "wait",
      "seconds": 6
    },
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.selftest",
      "contains": "PASS",
      "notContains": "FAIL",
      "label": "InGameTests"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "SuperSoundSliderThingPlus"
    },
    {
      "check": "noErrors",
      "source": "KydlCore"
    }
  ]
}
