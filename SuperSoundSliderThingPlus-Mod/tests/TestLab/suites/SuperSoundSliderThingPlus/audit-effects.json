    },
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.probe.scaledRatio",
      "args": {
        "expected": 0.5,
        "tolerance": 0.03
      },
      "expect": true,
      "label": "sfx_footstep at 50% mute plays at 50% of the game's volume"
    },
    {
