{
  "name": "audit-effects",
  "description": "AUDIT: every Effects sound is played at mute 0 / 50 / 100 and the volume the mod leaves on it is compared with the volume the game set",
  "timeout": 180,
  "steps": [
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.arena",
      "contains": "arena at"
    },
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.mute.set",
      "args": {
        "slider": "Effects",
        "value": 0
      },
      "contains": "Success"
    },
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.sound.play",
      "args": {
        "prefab": "sfx_footstep"
      },
      "contains": "playing",
      "label": "play sfx_footstep at mute 0"
    },
    {
      "do": "wait",
      "seconds": 0.12
    },
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.probe.scaledRatio",
      "args": {
        "expected": 1.0,
        "tolerance": 0.03
      },
      "expect": true,
      "label": "sfx_footstep at 0% mute plays at 100% of the game's volume"
    },
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.sound.clear"
    },
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.mute.set",
      "args": {
        "slider": "Effects",
        "value": 50
      },
      "contains": "Success"
    },
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.sound.play",
