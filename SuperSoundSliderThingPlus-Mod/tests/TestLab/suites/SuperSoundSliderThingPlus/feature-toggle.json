{
  "name": "feature-toggle",
  "description": "EnableAll off stops every feature and removes its hub tab (no stale UI registration); on starts them again (PROJECT_RULES 11, spec 4)",
  "timeout": 60,
  "steps": [
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.featureRunning",
      "args": {
        "id": "example"
      },
      "expect": true,
      "label": "running at start"
    },
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.exampleTab",
      "expect": true,
      "label": "tab registered"
    },
    {
      "do": "setConfig",
      "values": {
        "General/EnableAll": false
      }
    },
    {
      "do": "wait",
      "until": {
        "check": "hook",
        "name": "SuperSoundSliderThingPlus.featureRunning",
        "args": {
          "id": "example"
        },
        "expect": false
      },
      "timeout": 5
    },
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.exampleTab",
      "expect": false,
      "label": "tab removed while off"
    },
    {
      "do": "hook",
      "name": "kc.hubTabs",
      "args": {
        "mod": "com.kydldev.SuperSoundSliderThingPlus"
      },
      "notContains": "example",
      "label": "hub lists no example tab"
    },
    {
      "do": "setConfig",
      "values": {
        "General/EnableAll": true
      }
    },
    {
      "do": "wait",
      "until": {
        "check": "hook",
        "name": "SuperSoundSliderThingPlus.featureRunning",
        "args": {
          "id": "example"
        },
        "expect": true
      },
      "timeout": 5
    },
    {
      "do": "hook",
      "name": "SuperSoundSliderThingPlus.exampleTab",
      "expect": true,
      "label": "tab back"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "SuperSoundSliderThingPlus"
    }
  ]
}
