<Project Sdk="Microsoft.NET.Sdk">
  <!--
    SuperSoundSliderThingPlus mod. Everything shared by the user's mods (references from <Valheim>\Claude\ref, net48, no debug symbols,
    the shared code Kydl.Core / Kydl.Common, copy of the DLL to assets\, embedded bundle, the QA targets) comes from Claude\shared\Kydl.Mod.props / .targets.
    Add here only what is special about this mod (an extra reference: put the DLL into Claude\ref and add a line below).
    Build: dotnet build "SuperSoundSliderThingPlus-Mod\SuperSoundSliderThingPlus.csproj" -c Release
    QA:    dotnet msbuild "SuperSoundSliderThingPlus-Mod\SuperSoundSliderThingPlus.csproj" -t:UnitTests | IntegrationTests | TestLab | TestLabAll | Release
  -->
  <Import Project="..\..\Claude\shared\Kydl.Mod.props" />

  <PropertyGroup>
    <AssemblyName>SuperSoundSliderThingPlus</AssemblyName>
    <RootNamespace>SuperSoundSliderThingPlus</RootNamespace>
    <PackageId>SuperSoundSliderThingPlus</PackageId>
    <!-- AssetBundle built by the Unity project (Valheim > Build AssetBundles); embedded into the DLL when assets\supersoundsliderthingplus exists -->
    <BundleName>supersoundsliderthingplus</BundleName>
    <!-- every KydlDev mod requires KydlCore (T-070): the shared UI kit and the KY hub come from KydlCore.dll, nothing is compiled in twice.
         Build KydlCore first (the reference is its assets folder, see KydlCoreDll in Kydl.Mod.props). -->
    <!-- spec layout (MIGRATION_DECISIONS A8): the DLL goes to assets\ only, no build\ folder -->
    <KydlBuildFolder>false</KydlBuildFolder>
  </PropertyGroup>

  <ItemGroup>
    <!-- tests\ (NUnit + TestLab suites) and docs\ live inside this folder but are never part of the mod (spec 3: excluded from the release) -->
    <Compile Remove="tests\**;docs\**;release\**" />
    <None Remove="tests\**;docs\**;release\**" />
    <EmbeddedResource Remove="tests\**;docs\**;release\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- the mod's menu views live in the Unity project (previewed there) and are compiled into the mod from there -->
    <Compile Include="..\SuperSoundSliderThingPlus-Unity\Assets\SuperSoundSliderThingPlus_UI\Runtime\*.cs" Link="UiViews\%(Filename)%(Extension)" />
  </ItemGroup>

  <Import Project="..\..\Claude\shared\Kydl.Mod.targets" />
  <!-- quality runs only (KydlQuality=true, _agent\tools\test-quality.ps1): the unit tests see the internals of the mutated assembly; normal builds are unchanged -->
  <ItemGroup Condition="'$(KydlQuality)' == 'true'">
    <Compile Include="tests\QualityInternals.cs" />
  </ItemGroup>
</Project>
